# --- Django ---
# Production: DEBUG must be False and SECRET_KEY is then REQUIRED.
# Generate a key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, e.g. https://ledger.example.com
CSRF_TRUSTED_ORIGINS=
# Set to True once HTTPS is terminated in front of the app (enables SSL
# redirect, secure cookies and HSTS).
SECURE_TLS=False

# --- Database (PostgreSQL is mandatory) ---
POSTGRES_DB=ledgerhouse_db
POSTGRES_USER=ledgerhouse_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Restricted application role (production; see deploy/create_app_role.sql) ---
# Leave blank on first boot; after creating the role, set these and restart
# so the web app connects without superuser/BYPASSRLS privileges.
APP_DB_USER=
APP_DB_PASSWORD=

# --- LedgerHouse HMRC Developer Hub / VAT MTD ---
# Use only the separate LedgerHouse application. Never reuse another product's
# client ID, secret, redirect URI, subscription or activity record.
HMRC_ENVIRONMENT=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_APPLICATION_NAME=LedgerHouse
HMRC_APPLICATION_OWNER=
# Comma-separated names shown by the LedgerHouse Developer Hub application.
# Income Tax MTD needs Business Details, Obligations, Self Employment Business,
# BSAS, Individual Losses, Tax Liability Adjustments, Individual Calculations
# and Test Fraud Prevention Headers at the versions shown in the HMRC workspace.
HMRC_SUBSCRIBED_APIS=
HMRC_REDIRECT_URI=
HMRC_SCOPES=read:vat write:vat read:self-assessment write:self-assessment
HMRC_API_BASE_URL=
HMRC_AUTHORIZE_URL=
HMRC_TOKEN_URL=
HMRC_VENDOR_PUBLIC_IP=
HMRC_VENDOR_VERSION=

# --- HMRC XML Gateway ---
# CT600, FPS, EPS, CIS300, SA100, SA800 and SA900 use separate Transaction
# Engine registration and HMRC-issued test credentials.
HMRC_XML_TRANSPORT_ENABLED=False
HMRC_XML_VENDOR_ID=
HMRC_XML_SENDER_ID=
HMRC_XML_PASSWORD=
HMRC_XML_TEST_SUBMISSION_URL=https://test-transaction-engine.tax.service.gov.uk/submission
HMRC_XML_TEST_POLL_URL=https://test-transaction-engine.tax.service.gov.uk/poll

# --- Token encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Companies House ---
COMPANIES_HOUSE_API_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_FILING_PRESENTER_ID=
COMPANIES_HOUSE_FILING_AUTHENTICATION_VALUE=
COMPANIES_HOUSE_FILING_TEST_FLAG=1
COMPANIES_HOUSE_FILING_PACKAGE_REFERENCE=
COMPANIES_HOUSE_FILING_PRODUCT_KEY=ledgerhouse
# Keep false except during a deliberate, controlled XML Gateway test run.
COMPANIES_HOUSE_FILING_SEND_ENABLED=False
COMPANIES_HOUSE_FILING_GATEWAY_URL=https://xmlgw.companieshouse.gov.uk/v1-0/xmlgw/Gateway
# Both values must be explicitly true only after written Companies House live approval.
COMPANIES_HOUSE_FILING_LIVE_ENABLED=False
COMPANIES_HOUSE_LIVE_APPROVAL_CONFIRMED=False
